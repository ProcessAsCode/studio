# Algomation Studio Configuration

NODE_ENV=production
APP_NAME=Algomation Studio
APP_URL=https://studio.algomation.io

# Ports (unusual to avoid conflicts)
FRONTEND_PORT=37101
BACKEND_PORT=37100

# Database
POSTGRES_DB=algomation_studio
POSTGRES_USER=algomation
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_PASSWORD=CHANGE_ME

# Auth0 - UPDATE THESE
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_AUDIENCE=https://api.algomation.io

# Security
SESSION_SECRET=CHANGE_ME

# CORS
CORS_ORIGIN=https://studio.algomation.io

# Features
MAX_PROJECTS_PER_USER=50
MAX_PROJECT_SIZE_MB=10

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
